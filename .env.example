# =============================================================================
# Coastal View Mandarmani - Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control or hard-code secrets in the repository.
# =============================================================================

# Server Port
PORT=3000

# Persistent Database Directory / File Path (Optional)
# Set DATA_DIR (e.g. a persistent disk mount outside the build folder) so admin/staff accounts
# and reservations survive restarts and redeployments. Defaults to ./data.
# DATA_DIR=
# DB_PATH=

# Super Admin Setup
# Specify the Super Admin email address before running "npm run create-super-admin"
ADMIN_EMAIL=

# Session Security & Encryption Key (Generate a 64-character random string)
SESSION_SECRET=
COOKIE_SECURE=false

# MFA / TOTP Secret Encryption Key (AES-256-GCM encryption at rest)
# If left empty, the system securely defaults to SESSION_SECRET.
# A dedicated 256-bit key (64 hex characters) can be provided for defense-in-depth.
MFA_ENCRYPTION_KEY=

# Settings Encryption Key (AES-256-GCM encryption at rest for App Passwords)
# Generate with: openssl rand -base64 32
# If missing, saving email settings in admin panel is refused (never saved in plaintext).
SETTINGS_ENCRYPTION_KEY=

# Application Public URL (used in password reset and notification email links)
APP_URL=http://localhost:3000

# Gmail SMTP Free Mail Server (Nodemailer integration)
# Variables: SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS, MAIL_FROM, MAIL_FROM_NAME, ADMIN_EMAIL, APP_URL
# Port 465 uses SSL/TLS (SMTP_SECURE=true). Port 587 uses STARTTLS (SMTP_SECURE=false).
# SMTP_PASS should be a 16-character Google App Password (not your account login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_account@gmail.com
SMTP_PASS=your_google_app_password
MAIL_FROM=your_account@gmail.com
MAIL_FROM_NAME="Coastal View · Managed By Ani's"
SMTP_DAILY_LIMIT=300

# Optional TOTP App Issuer Name
TOTP_ISSUER=CoastalViewMandarmani

# Node Environment (development or production)
NODE_ENV=development

# =============================================================================
# AI Concierge Chatbot LLM Configuration ("Ani's Coastal Concierge")
# Architecture: Swappable Provider Interface (Claude, Gemini, OpenAI, OpenRouter)
# The model can be swapped seamlessly by changing environment variables only.
# Default fallback: Grounded Database Knowledge Engine with 13 backend tools.
# =============================================================================
# Provider options: "gemini" | "anthropic" | "openai" | "openrouter"
LLM_PROVIDER=gemini

# Provider API Key (never exposed to frontend code)
LLM_API_KEY=

# Default fast, low-cost model recommendations:
# - Gemini: "gemini-1.5-flash"
# - Anthropic Claude: "claude-3-5-haiku-20241022"
# - OpenAI: "gpt-4o-mini"
# - OpenRouter: "meta-llama/llama-3.1-8b-instruct"
LLM_MODEL=gemini-1.5-flash

# Optional: Custom endpoint / proxy / base URL
# (Leave blank for official provider API endpoints)
LLM_BASE_URL=


# =============================================================================
# Cloudflare Turnstile CAPTCHA (Bot Protection for Admin Portal)
# Free, privacy-friendly alternative to reCAPTCHA/hCaptcha.
# Setup Guide:
# 1. Sign up / log in to Cloudflare Dashboard (https://dash.cloudflare.com/)
# 2. Select "Turnstile" from the left navigation menu and click "Add site".
# 3. Site name: "Coastal View Admin Portal"
# 4. Domain: add your production domain (e.g. coastalviewmandarmani.com)
#    AND add "localhost" as an allowed hostname for local development & testing.
# 5. Widget Mode: "Managed" (recommended)
# 6. Copy the generated Site Key and Secret Key into .env locally and into Hostinger env vars.
# Note: On localhost in development (when NODE_ENV is not production),
# the system automatically uses Cloudflare's official always-pass test keys:
# Site Key: 1x00000000000000000000AA
# Secret Key: 1x0000000000000000000000000000000AA
# In production (NODE_ENV=production), real keys are mandatory and strictly enforced.
# =============================================================================
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# CAPTCHA Policy: "smart" (after 2 failed attempts or rate limiting) or "always" (on every login)
CAPTCHA_POLICY=smart

