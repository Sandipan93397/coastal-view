# Hostinger Business Node.js Web Hosting Configuration for Coastal View Hotel
# Production Engine: Node.js (Express - server.js)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce HTTPS Redirect
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Block direct public HTTP access to internal directories & server modules
  RewriteRule ^(data|scripts|scratch|dist)/ - [F,L]
  RewriteRule ^(test_.*|verify_.*|server|auth_security|db_store|email_service|media_security|invoice_generator|settings_crypto|roles_permissions|init_db|migrate_.*|seed_.*|update_room_inventory|build_.*)\.js$ - [F,L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Prevent viewing of sensitive, test, database, or configuration files
<FilesMatch "^(\.env.*|\.git.*|\.htaccess|\.dockerignore|\.deployignore|composer\.json|package\.json|package-lock\.json|render\.yaml|test_.*\.js|verify_.*\.js|.*\.sqlite.*|.*\.bak.*|.*backup.*\.json)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Enable GZIP Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>
